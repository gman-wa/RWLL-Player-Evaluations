# Copied to local.env (untracked) by scripts/local-dev.sh up. DB_HOST is added by the script.
SERVER_LOCATION=docker
DB_NAME=RWLL
DB_USER=rwll_db
DB_PASSWORD=change-me
# /admin (progress and the CSV) - empty turns admin off
ADMIN_PIN=change-me
# local: photos go to storage/photos and Apache serves them at /photos
PHOTO_STORAGE=local
PHOTO_URL=/photos/{file}
MAX_BIB=3000
